# used for schema check in sqlx by rust-analyzer - needed to compile code
PG__USER=root
PG__PASSWORD=root
PG__HOST=localhost
PG__PORT=5000
PG__DBNAME=exchange-db
PG__POOL_MAX_SIZE=16

DATABASE_URL=postgres://${PG__USER}:${PG__PASSWORD}@${PG__HOST}:${PG__PORT}/${PG__DBNAME}

REDIS_URL=redis://localhost:6380
SERVER_ADDR=0.0.0.0:7000
WS_STREAM_URL=0.0.0.0:7003
API_KEY=your-secret-api-key-here

# Optional: set to a single origin (e.g. https://app.example.com) to restrict CORS. Empty = allow any origin.
# CORS_ALLOWED_ORIGIN=